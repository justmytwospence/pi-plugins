#!/bin/sh
# Install root dependencies when a new worktree (or clone) is checked out.
# Enable once per clone: git config core.hooksPath .githooks
case "$1" in *[!0]*) exit 0 ;; esac
[ -f package-lock.json ] || exit 0
[ -d node_modules ] && exit 0
echo "post-checkout: npm ci in $(pwd)" >&2
npm ci --prefer-offline --no-audit --no-fund >&2 || echo "post-checkout: npm ci failed; run it here, then /reload" >&2
exit 0
