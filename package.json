{
  "name": "@justmytwospence/pi-plugins",
  "version": "0.1.2",
  "description": "A modular Pi extension suite: independently enabled components, one tested Git release.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins"
  },
  "pi": {
    "extensions": [
      "./packages/pi-vim/src/index.ts",
      "./packages/pi-stash/src/index.ts",
      "./packages/pi-todo/index.ts",
      "./packages/pi-ask-user-question/src/index.ts",
      "./packages/pi-plan-mode/src/index.ts",
      "./packages/pi-status-footer/src/index.ts",
      "./packages/pi-rewind/src/index.ts",
      "./packages/pi-clear-screen/src/index.ts",
      "./packages/pi-select-nav/src/index.ts",
      "./packages/pi-herdr-scrollbar-width/src/index.ts",
      "./packages/pi-herdr/src/index.ts",
      "./packages/pi-recap/src/index.ts",
      "./packages/pi-sidebar/src/index.ts",
      "./packages/pi-subagents/src/index.ts",
      "./packages/pi-tool-gate/src/index.ts",
      "./packages/pi-bg/src/index.ts",
      "./packages/pi-auto-effort/src/index.ts",
      "./packages/pi-appearance-resync/src/index.ts",
      "./packages/pi-copy/src/index.ts",
      "./packages/pi-marimo/src/index.ts",
      "./packages/pi-cache-guard/src/index.ts",
      "./packages/pi-next-prompt/src/index.ts",
      "./packages/pi-diff-review/src/index.ts",
      "./packages/pi-prose-width/src/index.ts",
      "./packages/pi-sticky-last-prompt/src/index.ts",
      "./packages/pi-cc-render/src/index.ts",
      "./packages/pi-markdown-extras/src/index.ts",
      "./packages/pi-context/src/index.ts",
      "./packages/pi-trends/src/index.ts",
      "./packages/pi-mcp-device-login/src/index.ts"
    ],
    "themes": [
      "./packages/pi-cc-render/themes/cc-dark.json",
      "./packages/pi-cc-render/themes/cc-light.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@shikijs/cli": "^4.4.3",
    "grok-mermaid": "^0.2.2",
    "marked": "^18.0.11",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0"
  },
  "scripts": {
    "test": "node scripts/test-loader.mjs && node scripts/test-shortcuts.mjs && node scripts/test-contracts.mjs && node scripts/test-question-flow.mjs && node scripts/test-lifecycle.mjs",
    "check": "npm test && node scripts/check-components.mjs",
    "check:clients": "node scripts/test-remote-clients.mjs"
  }
}
