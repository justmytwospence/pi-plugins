{
  "name": "@justmytwospence/pi-cache-guard",
  "version": "0.1.2",
  "description": "Asks before a Pi prompt that would re-cache a large conversation, shows the prompt cache's time left, and keeps the context lean with Jev: trimmed tool output and one-second compaction.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "prompt-cache",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config ../../evals/shared/vitest.config.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-cache-guard"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-cache-guard/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
