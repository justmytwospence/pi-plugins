{
  "name": "@justmytwospence/pi-clear-screen",
  "version": "0.1.0",
  "description": "ctrl+l clears pi's fullscreen transcript like a shell clears the screen, keeping history.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "keybindings",
    "clear",
    "fullscreen"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-clear-screen"
  }
}
