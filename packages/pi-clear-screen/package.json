{
  "name": "@justmytwospence/pi-clear-screen",
  "version": "0.1.2",
  "description": "ctrl+l clears pi's fullscreen transcript like a shell clears the screen, keeping history.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "keybindings",
    "clear",
    "fullscreen"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-clear-screen"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-clear-screen/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
