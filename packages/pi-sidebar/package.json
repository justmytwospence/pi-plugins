{
  "name": "@justmytwospence/pi-sidebar",
  "version": "0.1.2",
  "description": "Sidebar: a live, read-only side chat in a Herdr pane beside a working Pi session, sharing its prompt cache.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "herdr",
    "side-chat"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node ../../scripts/eval.mjs --package pi-sidebar"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-sidebar"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.4",
    "pi-coding-agent-1-4": "npm:@earendil-works/pi-coding-agent@1.4.0",
    "pi-tui-1-4": "npm:@earendil-works/pi-tui@1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-sidebar/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
