{
  "name": "@justmytwospence/pi-rewind",
  "version": "0.1.2",
  "description": "Restore files alongside pi's conversation rewinds (/tree and /fork).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "rewind",
    "undo",
    "git"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-rewind"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-rewind/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
