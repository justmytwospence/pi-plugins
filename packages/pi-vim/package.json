{
  "name": "@justmytwospence/pi-vim",
  "version": "0.1.2",
  "description": "Vim modal editing for Pi's editor, with an optional editor factory other suite components use for embedded editors.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "vim",
    "editor"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "test:nvim": "node --import tsx/esm --test 'test/nvim-parity*.ts'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.4",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-vim"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-vim/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
