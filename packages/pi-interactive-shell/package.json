{
  "name": "@justmytwospence/pi-interactive-shell",
  "version": "0.1.2",
  "description": "Explicit human-operated terminal handoffs for Pi: !i runs a foreground command without capturing input or output.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/prepare-pty.cjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-interactive-shell"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-interactive-shell/",
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
