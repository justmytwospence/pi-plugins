{
  "name": "@justmytwospence/pi-diff-review",
  "version": "0.1.0",
  "description": "Review what the agent changed in Pi: per-turn and unreviewed diffs, vim keys, and line comments sent back to the agent.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "diff",
    "code-review",
    "git"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-diff-review"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "~1.0.2",
    "@earendil-works/pi-tui": "~1.0.2",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
