{
  "name": "@justmytwospence/pi-next-prompt",
  "version": "0.1.0",
  "description": "Suggests your next prompt after a run, Claude Code style: ghost text in the empty editor, Tab to accept. Only when there is one obvious next step.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": ["pi-package", "pi-extension", "pi", "jev"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-next-prompt"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
