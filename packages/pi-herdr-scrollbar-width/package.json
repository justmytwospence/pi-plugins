    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-herdr-scrollbar-width"
  }
}
