{
  "name": "@justmytwospence/pi-btw",
  "version": "0.1.2",
  "description": "/btw side conversations in a focused overlay: a real Pi sub-session that runs while the main agent is busy, with hidden thread state, read-only tools for /btw:ask, and inject/summarize handoff.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "UPSTREAM.json"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "btw",
    "side-conversation",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-btw"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-btw/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
