{
  "name": "@justmytwospence/pi-auto-effort",
  "version": "0.1.2",
  "description": "Sets Pi's thinking level per message you send: Jev rates how demanding it is, a threshold that tightens under quota pressure picks the level, capped at the level you chose.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node ../../scripts/eval.mjs --package pi-auto-effort"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justmytwospence/pi-plugins",
    "directory": "packages/pi-auto-effort"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "homepage": "https://pi-plugins.vercel.app/plugins/pi-auto-effort/",
  "bugs": {
    "url": "https://github.com/justmytwospence/pi-plugins/issues"
  }
}
